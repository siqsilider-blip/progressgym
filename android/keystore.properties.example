# Copiá este archivo como android/keystore.properties y completalo localmente.
# keystore.properties está excluido de Git y nunca debe compartirse.
# Usá una ruta absoluta con barras normales para evitar escapes en Windows.

storeFile=C:/ruta/segura/fuera-del-repositorio/progrezzia-upload.jks
storePassword=REEMPLAZAR_EN_LA_PC
keyAlias=upload
keyPassword=REEMPLAZAR_EN_LA_PC

# Alternativa para automatización/CI: no crear este archivo y definir:
# PROGREZZIA_UPLOAD_STORE_FILE
# PROGREZZIA_UPLOAD_STORE_PASSWORD
# PROGREZZIA_UPLOAD_KEY_ALIAS
# PROGREZZIA_UPLOAD_KEY_PASSWORD
